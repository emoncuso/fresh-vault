<h1> Login </h1>

<form method="POST" {{on "submit" this.login.perform}}>
  <div>
    <label for="path">Path</label>
    <input 
      id="path" 
      name="path" 
      type="text" 
      value="/"
      readonly
      autocomplete="off" 
    />
  </div>
  <div>
    <label for="token">Token</label>
    <input 
      id="token" 
      name="token" 
      type="text" 
      required 
      aria-required="true" 
      autocomplete="off" 
    />
  </div>
  <button type="submit">
    Login
  </button>
</form>